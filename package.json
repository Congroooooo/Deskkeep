{
  "name": "deskkeep",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "A private local-first desktop vault and life OS.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "test:packaged": "node scripts/packaged-check.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.0.3",
    "lucide-react": "0.548.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "45.0.0",
    "simple-icons": "^16.35.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  }
}
